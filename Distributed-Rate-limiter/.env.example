# ==============================================================================
# Distributed-Rate-limiter Environment Configuration Template
# Copy this file to .env and replace placeholder values with your credentials.
# ==============================================================================

# Server Runtime Configuration
PORT=3000
NODE_ENV=development
FORTEND_URL=http://localhost:3000

# PostgreSQL Database Configuration (Prisma ORM)
# Local host connection (if accessing Postgres directly from host):
DATABASE_URL="postgresql://postgres:12345@localhost:5432/WorkList?schema=public"
# Docker network connection (if running inside Docker container):
# DATABASE_URL="postgresql://postgres:12345@postgres_service:5432/WorkList?schema=public"

DB_USER=postgres
DB_PASSWORD=12345
DB_NAME=WorkList

# Redis Distributed Cache Configuration
# Host port mapping is 6380; Docker container internal port is 6379
REDIS_HOST=localhost
REDIS_PORT=6380
# Inside Docker container:
# REDIS_HOST=redis_service
# REDIS_PORT=6379

# Rate Limiter Engine Settings
RATE_LIMITER_REDIS_TTL_MS=300000
RATE_LIMITER_CLEANUP_MS=60000

# Security, Cryptography & JWT Tokens
# Generate production keys using: openssl rand -base64 32
PRIVATEJWT=replace_with_a_secure_random_access_jwt_secret_min_32_chars
RefreshPRIVATEJWT=replace_with_a_secure_random_refresh_jwt_secret_min_32_chars
SALT_ROUNDS=10
