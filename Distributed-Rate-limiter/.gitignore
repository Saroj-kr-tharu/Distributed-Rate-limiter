# ==============================================================================
# Production .gitignore - Distributed-Rate-limiter Engine
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs & Bundles
dist/
build/
.tsup/
*.tsbuildinfo

# Environment & Secrets (NEVER commit credentials)
.env
.env.*
!.env.example
!.env.test.example

# Runtime Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Prisma Generated Client & DB Artifacts
/src/generated/prisma/
prisma/generated/
*.db
*.db-journal

# In-Memory Cache & Storage Dumps
dump.rdb
appendonly.aof

# Testing & Coverage
coverage/
.nyc_output/

# OS & Editor Artifacts
.DS_Store
Thumbs.db
ehthumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*~
