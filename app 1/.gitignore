# ==============================================================================
# Production .gitignore - App 1 (Client Microservice)
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs & Bundles
dist/
build/
.tsup/
*.tsbuildinfo

# Environment & Secrets (NEVER commit credentials)
.env
.env.*
!.env.example
!.env.test.example

# Runtime Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing & Coverage
coverage/
.nyc_output/

# OS & Editor Artifacts
.DS_Store
Thumbs.db
ehthumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*~
